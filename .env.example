# ---------------------------------------------------------------------------
# Wassl environment
# Copy to `.env.local` (gitignored) and fill in what you need.
# ---------------------------------------------------------------------------

# Session signing secret. Required in production.
WASSL_SECRET=change-me-to-a-long-random-string

# Public origin used for canonical URLs and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Persistence -----------------------------------------------------------
# Leave DATABASE_URL empty for the zero-config JSON demo store (`data/db.json`).
# Set it to a Supabase/Postgres connection string for the production backend.
# The schema is created automatically on first use.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/wassl
# DATABASE_SSL=no-verify
# WASSL_PG_POOL_MAX=5
# Read cache in milliseconds. 0 (default) always reads the latest committed row.
# WASSL_PG_CACHE_MS=0
# Optional row key when several environments share one database.
# WASSL_DB_STATE_ID=platform
# Force the demo backend even if DATABASE_URL is present:
# WASSL_DB=json

# Local JSON data directory (ignored when DATABASE_URL is set).
# WASSL_DATA_DIR=./data

# --- Authentication --------------------------------------------------------
# Email + password sign-in is the primary flow. Customers can self-sign-up and
# are active immediately; store owners and drivers stay pending until an
# operator approves them in Admin -> Accounts. Admins are provisioned only.
#
# The operator account is created (or its password rotated) on the next login.
WASSL_ADMIN_EMAIL=ops@wassl.ma
# Set a long, unique value in production.
# WASSL_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Demo account passwords can be rotated independently.
# WASSL_DEMO_STORE_PASSWORD=replace-me
# WASSL_DEMO_DRIVER_PASSWORD=replace-me
# WASSL_DEMO_CUSTOMER_PASSWORD=replace-me
# Comma-separated extra addresses allowed to claim admin through the staff flow.
# Normal admin access uses WASSL_ADMIN_EMAIL above.
WASSL_ADMIN_EMAILS=ops@wassl.ma

# --- Web Push (VAPID) ------------------------------------------------------
# Generate once with `npx web-push generate-vapid-keys`. Keep the private key
# server-only. The subject must be a mailto: or https: URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@wassl.ma

# --- Transactional email (Brevo) -------------------------------------------
# Used for signup email verification and order notifications. The sender must
# be verified inside the Brevo account. Never commit the API key.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=abbasidi0095@gmail.com
BREVO_SENDER_NAME=Wassl
# Optional Reply-To, e.g. support@wassl.ma
# BREVO_REPLY_TO=

# --- Phone OTP: SMS and/or WhatsApp -----------------------------------------
# Staged rollout. Keep all three at 0 until a channel is ready.
PHONE_VERIFICATION_REQUIRED=0
OTP_SMS_ENABLED=0
OTP_WHATSAPP_ENABLED=0
OTP_DEFAULT_CHANNEL=whatsapp

# Aion Messaging (SMS). Sender ID must be approved and the wallet funded.
AION_API_KEY=
AION_SENDER_ID=WASSL
# AION_BASE_URL=https://aionmessaging.com/api/v1

# OpenWA (WhatsApp, unofficial). Bind it to loopback and use a dedicated number.
OPENWA_BASE_URL=http://127.0.0.1:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_ID=wassl-otp

# E2E only: skip Brevo/SMS and return verification codes in API responses.
# Never enable this on a public deployment or in production.
# WASSL_OTP_TEST_MODE=1

# Supabase mirrors verified profiles into its `users` table. The publishable
# key is safe for the browser; the service-role key is server-only and is what
# allows writes. Run supabase/schema.sql once in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=https://vgntmhvyhpnkceajfgqk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_IF-bN46qAXmbDi0Fn_sNqA_6sQ1OU3_
# SUPABASE_SERVICE_ROLE_KEY=

# --- Restaurant directory --------------------------------------------------
# The importer uses these; the live provider needs MAROCAPIS_API_KEY.
MAROCAPIS_API_KEY=
SERPAPI_API_KEY=
# locked (default) serves the sealed snapshot; live queries the directory.
RESTAURANT_DATA_SOURCE=locked


# --- Wassl Assistant (NVIDIA NIM) -----------------------------------------
# Server-only. Never expose this key to the browser or commit it.
NVIDIA_API_KEY=
# Defaults to nvidia/nemotron-3.5-lightning-30b-a3b.
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
